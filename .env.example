PANEL_BASE_URL=https://panel.example.com
PANEL_API_TOKEN=change-me
PANEL_NODES_PATH=/api/nodes
PANEL_VERIFY_TLS=true
PANEL_REQUEST_TIMEOUT=20
PANEL_ALLOW_EMPTY_RESPONSE=false

ADMIN_API_TOKEN=change-me-too
SYNC_INTERVAL_SECONDS=3600
RUN_SYNC_ON_STARTUP=true
# Comma-separated identifiers/names which must survive disappearance from Panel API.
PROTECTED_NODE_IDS=
PROTECTED_NODE_NAMES=bot,panel

SSH_PRIVATE_KEY_PATH=/run/secrets/id_ed25519
SSH_KNOWN_HOSTS_PATH=/app/data/known_hosts
SSH_HOST_KEY_POLICY=accept-new
SSH_CONNECT_TIMEOUT=15
SSH_COMMAND_TIMEOUT=120
SSH_RETRIES=2

NODE_EXPORTER_PORT=9100
NODE_EXPORTER_VERSION=1.9.1
CONFIGURE_FIREWALL=false
PROMETHEUS_SOURCE_IP=

PROMETHEUS_TARGETS_FILE=/prometheus-targets/nodes.json
DATABASE_PATH=/app/data/state.db
LOG_LEVEL=INFO
